<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Views.ConectarDispositivosActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:orientation="vertical">
        <TextView
            android:text="Conectar dispositivos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:text="Asegúrate de que los dispositivos estén encendidos"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <!-- Tarjeta ESP32 — solo visible si necesitaESP32() -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardESP32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="ESP32 — MicroC"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvEstadoESP32"
                        android:text="Esperando..."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <!-- Indicador de estado -->
                <View
                    android:id="@+id/indicadorESP32"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/circle_gray"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta Watch — solo visible si necesitaWatch() -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Smartwatch — Wear OS"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvEstadoWatch"
                        android:text="Esperando..."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <View
                    android:id="@+id/indicadorWatch"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/circle_gray"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón reintentar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReintentar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reintentar conexión"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- Botón iniciar — deshabilitado hasta que todo esté conectado -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarPrueba"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar prueba"
            android:enabled="false"/>
    </LinearLayout>

</LinearLayout>